# Copy this file to config/test_data.yaml for local use.
# Do not commit config/test_data.yaml.
# All values below are placeholders. Do not put real secrets in this example.

accounts:
  admin:
    email: "YOUR_ADMIN_EMAIL"
    password: "YOUR_ADMIN_PASSWORD"
  normal:
    email: "YOUR_NORMAL_USER_EMAIL"
    password: "YOUR_NORMAL_USER_PASSWORD"
  readonly:
    email: "YOUR_READONLY_USER_EMAIL"
    password: "YOUR_READONLY_USER_PASSWORD"
  invalid_password:
    email: "YOUR_NORMAL_USER_EMAIL"
    password: "WRONG_TEST_PASSWORD"

login:
  invalid_password:
    password: "WRONG_TEST_PASSWORD"
  empty_email:
    email: ""
  empty_password:
    password: ""
  empty_email_password:
    email: ""
    password: ""
  invalid_email_format:
    email: "invalid-email-format"

chat:
  question_normal: "Open Web automated input draft"
  question_multiline: "Line one\nLine two"
  question_long: "Long chat question placeholder"

search:
  keyword_normal: "project"
  keyword_empty: ""
  keyword_long: "long search keyword placeholder"

workspace:
  workspace_default: "Default Workspace"
  workspace_empty: ""

model:
  default_model: "default-model"
  fallback_model: "fallback-model"

knowledge:
